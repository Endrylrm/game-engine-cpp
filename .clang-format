BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
TabWidth: 4
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
IndentAccessModifiers: false
AllowShortIfStatementsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBraces: Allman
AlignAfterOpenBracket: BlockIndent
AlignArrayOfStructures: Left
BinPackArguments: false
BinPackParameters: false
PackConstructorInitializers: NextLine
# includes
IncludeBlocks: Regroup
SortIncludes:
  Enabled: true
  IgnoreCase: false
IncludeCategories:
  - Regex:           '^<([a-z0-9_]+)>$'                     # Standard C/C++ library headers
    Priority:        1
  - Regex:           '^<(glad|glm|nlohmann|SDL3.*)/.*>$'    # vendors
    Priority:        2
  - Regex:           '^"engine/.*"$'                        # Project-specific system headers
    Priority:        3
  - Regex:           '^"game/.*"$'                          # Game-specific System headers
    Priority:        4
  - Regex:           '^".*"'                                # local headers
    Priority:        5