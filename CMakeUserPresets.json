{
  "version": 9,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "local-gcc",
      "displayName": "GCC Compiler",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "local-clang",
      "displayName": "Clang Compiler",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "local-windows-gcc",
      "displayName": "Windows GCC Compiler + VCPKG",
      "inherits": "windows-default",
      "environment": {
        "VCPKG_ROOT": "C:/dev/vcpkg",
        "VCPKG_DEFAULT_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_DEFAULT_HOST_TRIPLET": "x64-mingw-dynamic"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "local-windows-clang",
      "displayName": "Windows Clang Compiler + VCPKG",
      "inherits": "windows-default",
      "environment": {
        "VCPKG_ROOT": "C:/dev/vcpkg",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-clang",
        "VCPKG_HOST_TRIPLET": "x64-windows-clang"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "local-windows-msvc",
      "displayName": "Windows Visual Studio Compiler + VCPKG",
      "inherits": "windows-default",
      "environment": {
        "VCPKG_ROOT": "C:/dev/vcpkg",
        "VCPKG_DEFAULT_TRIPLET": "x64-windows",
        "VCPKG_DEFAULT_HOST_TRIPLET": "x64-windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default-build",
      "hidden": true,
      "configurePreset": "local-windows-clang"
    },
    {
      "name": "debug",
      "displayName": "Build Debug",
      "inherits": "default-build",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "inherits": "default-build",
      "configuration": "release"
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Build Release with Debug Info",
      "inherits": "default-build",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "minsizerel",
      "displayName": "Build Minimal Size Release",
      "inherits": "default-build",
      "configuration": "MinSizeRel"
    }
  ]
}